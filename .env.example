# Placeholders only. NEVER put real keys here. Real values go in Netlify site settings / local .env.local.
# Use the NEW emns Supabase project, never the live VetProtect project.
VITE_SUPABASE_URL=https://YOUR-EMNS-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_EMNS_PUBLISHABLE_KEY

# Function-side (Netlify env vars, not this file)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_WEBHOOK_BASE_URL=
# EMNS_MESSAGE_PROVIDER=mock        # mock (default) | twilio
# EMNS_ALLOW_REAL_SEND=false        # must be 'true' for the twilio provider to send
# TWILIO_ENFORCE_SIGNATURE=true     # enforcement is ON by default; set 'false' only for local debugging
# Broadcast engine (functions): long random string shared by send-event, the worker and the sweeper
# EMNS_WORKER_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# EMNS_SEND_RATE_PER_SEC=5
# EMNS_SEND_BATCH=50
# EMNS_SEND_CONCURRENCY=10
