map $http_x_forwarded_proto $fwd_proto { default $http_x_forwarded_proto; '' $scheme; }
# One address for everything: the app, the data API and sign-in. Same origin, so the browser needs no cross-site settings.
server {
  listen 80;
  client_max_body_size 4m;
  location /rest/v1/ { proxy_pass http://${UPSTREAM_REST}/; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; }
  location /auth/v1/ { proxy_pass http://${UPSTREAM_AUTH}/; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; }
  location /healthz  { access_log off; return 200 'ok'; add_header Content-Type text/plain; }
  location / {
    proxy_pass http://${UPSTREAM_APP};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
}
